              </ownedParameter>
              <language>java</language>
              <body>Instrumento tambor= new Instrumento();&#xD;
		Solista solista = new Solista();&#xD;
		tambor.setSonido(&quot;pom, pom pom&quot;);&#xD;
		solista.setInstrumento(tambor);&#xD;
		solista.tocar();&#xD;
&#xD;
	</body>
