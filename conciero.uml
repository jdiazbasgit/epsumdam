          <packagedElement xmi:type="uml:Class" xmi:id="_7x1g0PJmEe6VuJ43ZG0qjg" name="CoinciertoMusico">
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_73EmIPJmEe6VuJ43ZG0qjg" name="main" specification="_7x3WAPJmEe6VuJ43ZG0qjg">
